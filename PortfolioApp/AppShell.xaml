<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PortfolioApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:page="clr-namespace:PortfolioApp.Pages"
    Shell.FlyoutBehavior="Disabled"
    Title="PortfolioApp">

    <ShellContent
        Route="StartPage"
        ContentTemplate="{DataTemplate page:StartPage}"
        Shell.TabBarIsVisible="False"
        />

    <TabBar>
        <Tab Title="API Status">
            <ShellContent
                Route="StatusPage"
                ContentTemplate="{DataTemplate page:StatusPage}"
                Shell.TabBarIsVisible="True" />
        </Tab>
        <Tab Title="Profile">
            <ShellContent
                Route="ProfilePage"
                ContentTemplate="{DataTemplate page:ProfilePage}"
                Shell.TabBarIsVisible="True" /> 
        </Tab>
    </TabBar>
</Shell>
